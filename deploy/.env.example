# 复制为 deploy/.env 后按需修改；deploy/.env 不入库（已在 .gitignore 中忽略）
# 用法：docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=root_dev_pwd
DB_PASSWORD=campus_dev_pwd

# ---- 宿主机端口（本机已占用时改这里，不动 compose 文件）----
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
WEB_PORT=80

# ---- Spring Profile ----
# prod,demo 会写入演示数据；正式上线只用 prod
SPRING_PROFILES=prod,demo

# ---- 字段加密密钥（32 字节 Base64，生产环境必须替换）----
CO_FIELD_KEY=GB7LwwDgcWpslCMsYtIkTbDrzER+IbjJwhtSu7LPz1I=

# ---- Cookie 是否只在 HTTPS 下发送（经反向代理发布 HTTPS 时改为 true）----
COOKIE_SECURE=false

# ---- Grafana 管理员密码 ----
GRAFANA_PASSWORD=admin
