# 复制为 deploy/.env 后按需修改；deploy/.env 不入库（已在 .gitignore 中忽略）
# 用法：docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=root_dev_pwd
DB_PASSWORD=campus_dev_pwd

# ---- 宿主机端口（本机已占用时改这里，不动 compose 文件）----
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
WEB_PORT=80

# ---- Spring Profile ----
# 默认只用 prod（干净环境）；演示需要种子数据时再写 prod,demo
SPRING_PROFILES=prod

# ---- 字段加密密钥 ----
# 必填，没有默认值：compose 用 ${CO_FIELD_KEY:?} 校验，未设置直接报错退出（避免带着示例密钥上线）
# 本机生成：
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
# 生产环境必须与演示环境不同
CO_FIELD_KEY=替换为本地生成的32字节Base64

# ---- Cookie 是否只在 HTTPS 下发送 ----
# prod 段默认 true；纯 HTTP 本地访问时置 false，否则登录态存不住
COOKIE_SECURE=false

# ---- Grafana 管理员密码 ----
GRAFANA_PASSWORD=admin
