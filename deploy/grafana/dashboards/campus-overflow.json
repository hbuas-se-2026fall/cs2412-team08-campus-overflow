{
  "uid": "campus-overflow-overview",
  "title": "CampusOverflow 核心监控面板",
  "tags": ["campus-overflow", "lab8"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "datasource": { "type": "prometheus", "uid": "prometheus" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP 请求 QPS",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count[5m]))", "legendFormat": "QPS" }
      ]
    },
    {
      "id": 2,
      "title": "接口 p95 延迟（秒）",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "max": 1 } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx 错误率",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 0.05 } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "5xx 率"
        }
      ]
    },
    {
      "id": 4,
      "title": "发件箱积压 co_outbox_backlog",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "co_outbox_backlog", "legendFormat": "积压事件" }
      ]
    },
    {
      "id": 5,
      "title": "死信事件 co_outbox_dead_letters",
      "type": "stat",
      "gridPos": { "x": 16, "y": 8, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [
        { "refId": "A", "expr": "co_outbox_dead_letters", "legendFormat": "死信" }
      ]
    },
    {
      "id": 6,
      "title": "声誉对账不一致 co_reputation_mismatches",
      "type": "stat",
      "gridPos": { "x": 20, "y": 8, "w": 4, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [
        { "refId": "A", "expr": "co_reputation_mismatches", "legendFormat": "不一致" }
      ]
    }
  ]
}
